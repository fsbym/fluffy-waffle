# 复制为 .env.local 并填入真实值（.env.local 不会被提交到 git）

# Supabase 项目网址：Supabase 控制台 → Project Settings → Data API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase secret key（只在服务器端使用，千万不要公开）：
# Project Settings → API Keys → Secret keys（sb_secret_...）
# 旧版项目也可以用 service_role key
SUPABASE_SECRET_KEY=sb_secret_xxx

# /admin 管理后台的登录密码，请设置一个足够长的随机密码
ADMIN_PASSWORD=change-me
