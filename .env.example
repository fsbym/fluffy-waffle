# 复制为 .env.local 并填入真实值（.env.local 不会被提交到 git）

# ── Supabase（Project Settings → API Keys / Data API）──
# 项目网址
SUPABASE_URL=https://your-project-ref.supabase.co
# secret key（sb_secret_...），只在服务器端使用，千万不要公开
SUPABASE_SECRET_KEY=sb_secret_xxx

# 浏览器端登录用（发邮件登录链接）。publishable key 本来就是公开的，可以放心放在前端
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ── 可选：Claude API，用 AI 检查同学上传的照片证据（console.anthropic.com → API Keys）──
# 不填就不做 AI 检查：照片仍然必填并公开展示，由投票的同学自己判断
# ANTHROPIC_API_KEY=sk-ant-xxx

# ── /admin 管理后台密码（只用来撤销违规提案、处理紧急情况）──
ADMIN_PASSWORD=change-me
